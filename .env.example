# Copy this file to .env before running:
#   copy .env.example .env

# Optional: prefill the QQ account shown by NapCat.
ACCOUNT=

# Host-side ports.
OPENQQWAIFU_PORT=8080
NAPCAT_HTTP_PORT=3000
NAPCAT_WS_PORT=3001
NAPCAT_WEBUI_PORT=6099

# NapCat WebUI token used by the QQ login bridge in openqqwaifu.
# If you do not set it here, leave it blank and then either:
# 1. read the current token from `docker logs napcat`, or
# 2. save the token later in the control panel's QQ 登录 page.
NAPCAT_WEBUI_TOKEN=

# Optional: override the bridge timeout in seconds.
OPENQQWAIFU_QQ_SIDECAR_WEBUI_TIMEOUT_SECONDS=10
